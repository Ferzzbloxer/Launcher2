<?xml version="1.0" encoding="utf-8"?>
<!--
  Adapted from the AOSP Launcher2 manifest for a standalone (non-system) build
  targeting Android 16. Changes from the original are called out in comments below.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REMOVED: <original-package android:name="com.android.launcher2" />
         Only meaningful for system-image upgrade paths; irrelevant for a
         standalone APK and will confuse the Play/package installer. -->

    <!-- CHANGED: protectionLevel "signature|privileged" requires the app to be
         signed with the platform key or preinstalled as a privileged system app.
         A sideloaded/store APK can never hold these, so they're downgraded.
         This means PRELOAD_WORKSPACE and WRITE_SETTINGS are no longer restricted
         to platform-signed callers only - acceptable for a personal/hobby launcher,
         but worth knowing if you ever expand this app's scope. -->
    <permission
        android:name="com.android.launcher.permission.PRELOAD_WORKSPACE"
        android:protectionLevel="signature" />
    <permission
        android:name="com.android.launcher.permission.INSTALL_SHORTCUT"
        android:protectionLevel="normal"
        android:label="@string/permlab_install_shortcut"
        android:description="@string/permdesc_install_shortcut" />
    <permission
        android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT"
        android:protectionLevel="normal"
        android:label="@string/permlab_uninstall_shortcut"
        android:description="@string/permdesc_uninstall_shortcut" />
    <permission
        android:name="com.android.launcher.permission.READ_SETTINGS"
        android:protectionLevel="normal"
        android:label="@string/permlab_read_settings"
        android:description="@string/permdesc_read_settings" />
    <permission
        android:name="com.android.launcher.permission.WRITE_SETTINGS"
        android:protectionLevel="signature"
        android:label="@string/permlab_write_settings"
        android:description="@string/permdesc_write_settings" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
         now explicitly rejects ACTION_DELETE requests from callers that don't hold this -
         without it, the uninstall confirmation activity starts, silently refuses, and exits
         without showing anything. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- REMOVED: CALL_PHONE - unused by Launcher2's own code paths as far as the
         dump shows; drop unless you find a call site that needs it.
         REMOVED: GET_ACCOUNTS_PRIVILEGED - signature|privileged only, not
         available to third-party apps at all. If account info is needed,
         use the AccountManager APIs that work with normal GET_ACCOUNTS instead. -->
    <uses-permission android:name="com.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.android.launcher.permission.WRITE_SETTINGS" />

    <!-- CHANGED: the implicit "default launcher gets automatic package
         visibility" exemption (Android 11+) is real but inconsistent across
         OEM skins, some of which restrict it further than stock AOSP. The
         explicit, vendor-independent fix for a launcher app is to declare
         a <queries> block matching exactly what LauncherModel queries for
         (ACTION_MAIN / CATEGORY_LAUNCHER) - this requires no special
         permission and is Play-Store-compliant. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
    </queries>

    <application
        android:name="com.android.launcher2.LauncherApplication"
        android:label="@string/application_name"
        android:icon="@mipmap/ic_launcher_home"
        android:hardwareAccelerated="true"
        android:largeHeap="@bool/config_largeHeap"
        android:supportsRtl="true">

        <!-- ADDED: android:exported="true" is now MANDATORY (not just default)
             for any component with an intent-filter, targeting API 31+. -->
        <activity
            android:name="com.android.launcher2.Launcher"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:theme="@style/LauncherTheme"
            android:windowSoftInputMode="adjustPan"
            android:screenOrientation="nosensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- REMOVED: MONKEY category - only relevant for old CTS/stress
                     tooling; harmless to drop. -->
            </intent-filter>
        </activity>

        <activity
            android:name="com.android.launcher2.WallpaperChooser"
            android:exported="true"
            android:theme="@style/Theme.WallpaperPicker"
            android:label="@string/pick_wallpaper"
            android:icon="@mipmap/ic_launcher_wallpaper"
            android:finishOnCloseSystemDialogs="true"
            android:process=":wallpaper_chooser">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.wallpaper.preview"
                android:resource="@xml/wallpaper_picker_preview" />
        </activity>

        <receiver
            android:name="com.android.launcher2.PreloadReceiver"
            android:exported="true"
            android:permission="com.android.launcher.permission.PRELOAD_WORKSPACE">
            <intent-filter>
                <action android:name="com.android.launcher.action.PRELOAD_WORKSPACE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.android.launcher2.InstallShortcutReceiver"
            android:exported="true"
            android:permission="com.android.launcher.permission.INSTALL_SHORTCUT">
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.android.launcher2.UninstallShortcutReceiver"
            android:exported="true"
            android:permission="com.android.launcher.permission.UNINSTALL_SHORTCUT">
            <intent-filter>
                <action android:name="com.android.launcher.action.UNINSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.android.launcher2.UserInitializeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_INITIALIZE" />
            </intent-filter>
        </receiver>

        <!-- CHANGED: implicit broadcast receivers for package events must be
             registered at RUNTIME on Android 8+ (registerReceiver in code),
             not in the manifest - manifest-declared implicit broadcasts for
             these actions are ignored by the OS. This receiver needs to move
             into LauncherApplication.onCreate() / a Service using
             Context.registerReceiver(). Left here commented as a reminder;
             remove once the runtime registration is added in code. -->
        <!--
        <receiver android:name="com.android.launcher2.PackageChangedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_CHANGED"/>
                <action android:name="android.intent.action.PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.PACKAGE_REMOVED"/>
                <data android:scheme="package"></data>
            </intent-filter>
        </receiver>
        -->

        <!-- If you change applicationId in build.gradle.kts, update the authority below
             to match, or another launcher/app already using the old authority could collide. -->
        <provider
            android:name="com.android.launcher2.LauncherProvider"
            android:authorities="com.android.launcher2.settings"
            android:exported="true"
            android:writePermission="com.android.launcher.permission.WRITE_SETTINGS"
            android:readPermission="com.android.launcher.permission.READ_SETTINGS" />

        <meta-data android:name="android.nfc.disable_beam_default"
            android:value="true" />
    </application>
</manifest>
